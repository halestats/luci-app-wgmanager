'use strict';
import * as fs from 'fs';
import { cursor } from 'uci';
import { manager, equal, options_equal } from '../root/usr/share/wgmanager/core.uc';
import { platform } from '../root/usr/share/wgmanager/platform.uc';
if (fs.readfile('/tmp/wgm-lab/isolated') != 'isolated-only\n') die('This test requires the isolated disposable kernel lab, never a router.');
let io=platform(), api=manager(io), count=0; io.lock();
function check(ok,note){if(!ok)die('ASSERT: '+note);printf('ok %d - %s\n',++count,note);}
function action(action,id,payload){let plan=api.prepare({action,peer_id:id,payload:sprintf('%J',payload??{})},'lab');return api.apply({token:plan.token},'lab');}
function rejected(code,callback){try{callback();}catch(e){check(index(e.message,code+'|')==0,'reject '+code);return;}die('Expected rejection: '+code);}
let start=io.snapshot();
if(length(start.uci_peers)!=3 || length(filter(start.uci_peers,p=>index(p.name,'lab-original-')==0))!=3)die('Not the disposable three-peer fixture.');
let initial_network=fs.readfile('/etc/config/network');
let plugin_id=action('create','',{name:'lab-new',address:''}).peer_id;
let before_adopt=io.snapshot();
let adopted=api.manage_existing();
check(adopted.adopted==3&&adopted.protected_count==0&&adopted.managed_count==4,'adopt three original peers alongside an existing plugin peer');
check(equal(before_adopt.peers,io.snapshot().peers)&&initial_network==fs.readfile('/etc/config/network'),'adoption changes no live peers or network configuration');
check(fs.lstat(adopted.backup).mode%512==384,'pre-adoption backup is root-private 0600');
check(api.manage_existing().adopted==0,'adoption is idempotent');
let status=api.status(), originals=filter(status.peers,p=>p.legacy);
check(length(originals)==3&&length(filter(originals,p=>p.exportable||p.protected||!p.managed||p.drift))==0,'adopted status exposes controls without private-key export or drift');
let one=filter(originals,p=>p.name=='lab-original-2')[0],two=filter(originals,p=>p.name=='lab-original-3')[0],three=filter(originals,p=>p.name=='lab-original-4')[0];
rejected('NO_PRIVATE_KEY',()=>api.export_peer({peer_id:one.id,qr:false}));
action('edit',one.id,{name:'renamed-old',address:'192.168.66.8'});
let snap=io.snapshot(), source=filter(snap.uci_peers,p=>p.public_key==one.public_key)[0];
check(source.name=='renamed-old'&&equal(source.allowed_ips,['192.168.66.8/32'])&&equal(snap.peers[one.public_key].allowed_ips,['192.168.66.8/32']),'edit persists original name/address and updates the real kernel');
check(source.options.route_allowed_ips=='1','unrelated peer options survive edit');
action('disable',one.id,{});
check(io.snapshot().peers[one.public_key]==null&&filter(io.snapshot().uci_peers,p=>p.public_key==one.public_key)[0].disabled=='1','disable persists and removes only selected original peer');
action('enable',one.id,{});
check(io.snapshot().peers[one.public_key].preshared_key=='(none)'&&io.snapshot().peers[one.public_key].persistent_keepalive==0,'enable restores a peer with no PSK');
action('disable',two.id,{});action('enable',two.id,{});
check(io.snapshot().peers[two.public_key].preshared_key==start.peers[two.public_key].preshared_key&&io.snapshot().peers[two.public_key].persistent_keepalive==25,'enable preserves original PSK and keepalive 25');
action('enable',three.id,{});check(io.snapshot().peers[three.public_key]!=null,'an originally disabled UCI peer can be enabled');
check(io.snapshot().peers[three.public_key].endpoint=='198.51.100.7:23456','enable restores the configured original endpoint');
action('disable',three.id,{});
let saved=io.save_state, fail_save=true;
io.save_state=function(state){if(fail_save){fail_save=false;die('STORAGE_ERROR|injected');}saved(state);};
rejected('APPLY_FAILED',()=>action('edit',one.id,{name:'should-rollback',address:'192.168.66.9'}));
io.save_state=saved;
check(filter(io.snapshot().uci_peers,p=>p.public_key==one.public_key)[0].name=='renamed-old'&&equal(io.snapshot().peers[one.public_key].allowed_ips,['192.168.66.8/32'])&&api.status().health=='ok','failed state save rolls back both UCI and real kernel');
let real_uci=io.change_uci_peer, fail_uci=true;
io.change_uci_peer=function(old,next,purpose){if(purpose=='apply'&&fail_uci){fail_uci=false;die('UCI_WRITE_FAILED|injected');}return real_uci(old,next,purpose);};
rejected('APPLY_FAILED',()=>action('edit',two.id,{name:'uci-failure',address:'192.168.66.9'}));
io.change_uci_peer=real_uci;
check(equal(io.snapshot().peers[two.public_key].allowed_ips,['192.168.66.3/32'])&&api.status().health=='ok','UCI write failure restores the original live peer');
let fail_again=true;
io.save_state=function(state){if(fail_again){fail_again=false;die('STORAGE_ERROR|injected');}saved(state);};
io.change_uci_peer=function(old,next,purpose){if(purpose=='rollback')die('UCI_WRITE_FAILED|injected rollback');return real_uci(old,next,purpose);};
rejected('RECOVERY_REQUIRED',()=>action('edit',two.id,{name:'recovery-test',address:'192.168.66.9'}));
check(api.status().health=='recovery','incomplete rollback retains journal and blocks management');
io.save_state=saved;io.change_uci_peer=real_uci;
check(api.recover().recovered&&api.status().health=='ok'&&equal(io.snapshot().peers[two.public_key].allowed_ips,['192.168.66.3/32']),'explicit recovery restores both original persistent and live configuration');
let external=cursor('/etc/config','/tmp/wgm-lab/external');external.load('network');external.set('network','labpeer3','description','externally-edited');external.save('network');external.commit('network');external.unload('network');
rejected('PEER_DRIFT',()=>action('disable',two.id,{}));
external.load('network');external.set('network','labpeer3','description','lab-original-3');external.save('network');external.commit('network');external.unload('network');
check(api.status().health=='ok','external target changes are rejected without disabling the live peer');
action('delete',one.id,{});
check(io.snapshot().peers[one.public_key]==null&&length(filter(io.snapshot().uci_peers,p=>p.public_key==one.public_key))==0,'delete persists and removes only selected original peer');
check(equal(io.snapshot().peers[two.public_key],start.peers[two.public_key]),'the other enabled original peer remains unchanged');
let ctx=cursor();ctx.load('network');check(ctx.get('network','wg','proto')=='wireguard'&&ctx.get('network','unrelated','device')=='dummy0','server and unrelated interface configuration preserved');ctx.unload('network');
check(api.status().health=='ok'&&length(api.status().peers)==3,'final state healthy with two original peers and one plugin peer');
action('delete',two.id,{});action('delete',three.id,{});
check(length(api.status().peers)==1&&api.status().health=='ok','all three adopted originals may be removed without the old baseline lock');
check(api.enable(true).mode=='manage','management remains usable after deleting all adopted original clients');
io.unlock();printf('PASS %d isolated real-kernel existing-peer checks\n',count);
