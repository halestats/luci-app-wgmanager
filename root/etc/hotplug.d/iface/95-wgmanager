#!/bin/sh
# Only restore plugin peers after netifd brings this WireGuard interface up.
[ "$ACTION" = ifup ] && [ -n "$INTERFACE" ] || exit 0
[ "$(uci -q get "network.$INTERFACE.proto")" = wireguard ] || exit 0
/usr/sbin/wgmanager --interface "$INTERFACE" restore >/dev/null 2>&1 ||
	logger -t wgmanager "Managed peers not restored on $INTERFACE; inspect doctor with --interface"
