#!/bin/sh /etc/rc.common
# Variables below are consumed by OpenWrt rc.common.
# shellcheck disable=SC2034
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/wgmanager-collector
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	/usr/sbin/wgmanager checkpoint >/dev/null 2>&1
}
